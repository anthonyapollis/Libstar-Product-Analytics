-- Generated by build_pbip.py from the same definitions as model.bim.

-- ===== table: fact_bet =====
GGR Tile Colour =
    IF ( [GGR] < 0, "#C8413A", "#1E8C5A" )
    -- hex colour for a KPI tile background

NGR Tile Colour =
    IF ( [NGR] < 0, "#C8413A", "#1E8C5A" )
    -- hex colour for a KPI tile background

Turnover =
    CALCULATE ( SUM ( fact_bet[total_stake] ), fact_bet[status] IN { "won", "lost" } )
    -- format: #,0.00

Payouts =
    CALCULATE ( SUM ( fact_bet[payout_amount] ), fact_bet[status] IN { "won", "lost" } )
    -- format: #,0.00

GGR =
    [Turnover] - [Payouts]
    -- format: #,0.00

Bonus Cost (realised) =
    CALCULATE ( SUM ( fact_bet[stake_bonus_amount] ), fact_bet[status] = "lost" )
    -- format: #,0.00

NGR =
    [GGR] - [Bonus Cost (realised)]
    -- format: #,0.00

-- ===== table: fact_bonus_transaction =====
Campaign Bonus Cost =
    CALCULATE ( SUM ( fact_bonus_transaction[granted_amount] ), fact_bonus_transaction[status] IN { "completed", "expired", "forfeited" } )
    -- format: #,0.00

Campaign Bonus Cost % of NGR =
    DIVIDE ( [Campaign Bonus Cost], CALCULATE ( [NGR], REMOVEFILTERS ( dim_campaign ) ) )
    -- format: 0.00%

Bonus Liability Outstanding =
    CALCULATE ( SUM ( fact_bonus_transaction[granted_amount] ), fact_bonus_transaction[status] = "active" )
    -- format: #,0.00

-- ===== table: fact_wallet_transaction =====
Deposits =
    CALCULATE ( SUM ( fact_wallet_transaction[amount] ), fact_wallet_transaction[txn_type] = "deposit" )
    -- format: #,0.00

Balance as of selected date =
    VAR AsOf = MAX ( dim_date[date_day] )
    RETURN
        CALCULATE (
            SUM ( fact_wallet_transaction[signed_amount] ),
            REMOVEFILTERS ( dim_date ),
            fact_wallet_transaction[transaction_date] <= AsOf,
            fact_wallet_transaction[status] = "posted"
        )
    -- format: #,0.00

-- ===== table: fct_recon_exceptions =====
Exceptions Tile Colour =
    IF ( [Exceptions] > 0, "#D9901A", "#1E8C5A" )
    -- hex colour for a KPI tile background

Act Now Tile Colour =
    IF ( [Act Now Value] > 0, "#C8413A", "#1E8C5A" )
    -- hex colour for a KPI tile background

Settlements Matched Exactly =
    CALCULATE ( COUNTROWS ( fct_recon_exceptions ), fct_recon_exceptions[category_type] = "OK" )
    -- format: #,0

Exceptions =
    CALCULATE ( COUNTROWS ( fct_recon_exceptions ), fct_recon_exceptions[category_type] <> "OK" )
    -- format: #,0

Exception Impact =
    CALCULATE ( SUM ( fct_recon_exceptions[financial_impact] ), fct_recon_exceptions[category_type] <> "OK" )
    -- format: #,0.00

Act Now Value =
    CALCULATE ( SUM ( fct_recon_exceptions[financial_impact] ), fct_recon_exceptions[category] IN { "BREAK: payment confirmed, wallet not credited", "BREAK: unrecognised settlement (no internal record)" } )
    -- format: #,0.00

-- ===== table: mart_recon_bridge =====
Residual Tile Colour =
    IF ( ABS ( [Bridge Residual] ) < 0.005, "#1E8C5A", "#C8413A" )
    -- hex colour for a KPI tile background

Bridge Amount =
    SUM ( mart_recon_bridge[amount] )
    -- format: #,0.00

Bridge Residual =
    SUM ( mart_recon_bridge[amount] ) - MAX ( mart_recon_bridge[gateway_settled_total] )
    -- format: #,0.00

-- ===== table: ingest_runs =====
Rejected Tile Colour =
    IF ( [Rows Rejected] > 0, "#D9901A", "#1E8C5A" )
    -- hex colour for a KPI tile background

Ingestion Runs =
    COUNTROWS ( ingest_runs )
    -- format: #,0

Rows Rejected =
    SUM ( ingest_runs[rows_rejected] )
    -- format: #,0

Rate-Limit Retries =
    SUM ( ingest_runs[rate_limit_hits] )
    -- format: #,0

-- ===== table: transactions =====
Transactions Loaded =
    DISTINCTCOUNT ( transactions[id] )
    -- format: #,0

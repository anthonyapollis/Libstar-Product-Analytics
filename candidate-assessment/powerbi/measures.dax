-- Generated by build_pbip.py from the same definitions as model.bim.

-- ===== table: fact_bet =====
Turnover =
    CALCULATE ( SUM ( fact_bet[total_stake] ), fact_bet[status] IN { "won", "lost" } )
    -- format: #,0.00

Payouts =
    CALCULATE ( SUM ( fact_bet[payout_amount] ), fact_bet[status] IN { "won", "lost" } )
    -- format: #,0.00

GGR =
    [Turnover] - [Payouts]
    -- format: #,0.00

Bonus Cost (realised) =
    CALCULATE ( SUM ( fact_bet[stake_bonus_amount] ), fact_bet[status] = "lost" )
    -- format: #,0.00

NGR =
    [GGR] - [Bonus Cost (realised)]
    -- format: #,0.00

-- ===== table: fact_bonus_transaction =====
Campaign Bonus Cost =
    CALCULATE ( SUM ( fact_bonus_transaction[granted_amount] ), fact_bonus_transaction[status] IN { "completed", "expired", "forfeited" } )
    -- format: #,0.00

Campaign Bonus Cost % of NGR =
    DIVIDE ( [Campaign Bonus Cost], CALCULATE ( [NGR], REMOVEFILTERS ( dim_campaign ) ) )
    -- format: 0.00%

Bonus Liability Outstanding =
    CALCULATE ( SUM ( fact_bonus_transaction[granted_amount] ), fact_bonus_transaction[status] = "active" )
    -- format: #,0.00

-- ===== table: fact_wallet_transaction =====
Deposits =
    CALCULATE ( SUM ( fact_wallet_transaction[amount] ), fact_wallet_transaction[txn_type] = "deposit" )
    -- format: #,0.00

Balance as of selected date =
    VAR AsOf = MAX ( dim_date[date_day] )
    RETURN
        CALCULATE (
            SUM ( fact_wallet_transaction[signed_amount] ),
            REMOVEFILTERS ( dim_date ),
            fact_wallet_transaction[transaction_date] <= AsOf,
            fact_wallet_transaction[status] = "posted"
        )
    -- format: #,0.00

            "name": "fact_wallet_transaction",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, (v) => if v = \"\" then null else v})),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"wallet_txn_id\", Int64.Type}, {\"wallet_id\", Int64.Type}, {\"player_id\", Int64.Type}, {\"txn_type\", type text}, {\"balance_type\", type text}, {\"amount\", Currency.Type}, {\"direction\", type text}, {\"signed_amount\", Currency.Type}, {\"balance_before\", Currency.Type}, {\"balance_after\", Currency.Type}, {\"related_bet_id\", Int64.Type}, {\"related_deposit_attempt_id\", Int64.Type}, {\"related_withdrawal_id\", Int64.Type}, {\"related_player_bonus_id\", Int64.Type}, {\"reversal_of_wallet_txn_id\", Int64.Type}, {\"idempotency_key\", type text}, {\"source_system\", type text}, {\"status\", type text}, {\"transaction_date\", type date}, {\"created_at_utc\", type datetime}}, \"en-US\")",

              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fact_bet.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, (v) => if v = \"\" then null else v})),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"bet_id\", Int64.Type}, {\"player_id\", Int64.Type}, {\"vip_tier_at_bet_time\", type text}, {\"product\", type text}, {\"channel\", type text}, {\"placed_date\", type date}, {\"stake_real_amount\", Currency.Type}, {\"stake_bonus_amount\", Currency.Type}, {\"total_stake\", Currency.Type}, {\"status\", type text}, {\"payout_amount\", Currency.Type}, {\"ggr_contribution\", Currency.Type}, {\"placed_at_utc\", type datetime}, {\"settled_at_utc\", type datetime}}, \"en-US\")",

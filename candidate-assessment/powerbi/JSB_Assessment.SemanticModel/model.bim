        "measures": [
          {
            "name": "GGR Tile Colour",
            "expression": "IF ( [GGR] < 0, \"#C8413A\", \"#1E8C5A\" )",
            "lineageTag": "2c410583-60a1-553d-ba13-a06e7a9ff6cc"
          },
          {
            "name": "NGR Tile Colour",
            "expression": "IF ( [NGR] < 0, \"#C8413A\", \"#1E8C5A\" )",
            "lineageTag": "fff82053-e84d-5dde-8234-13749e05c9b1"
          },
          {
            "name": "Turnover",
            "expression": "CALCULATE ( SUM ( fact_bet[total_stake] ), fact_bet[status] IN { \"won\", \"lost\" } )",
            "formatString": "#,0.00",
            "lineageTag": "7b651941-e331-5e81-b904-46dbc2becd3c"
          },
          {
            "name": "Payouts",
            "expression": "CALCULATE ( SUM ( fact_bet[payout_amount] ), fact_bet[status] IN { \"won\", \"lost\" } )",
            "formatString": "#,0.00",
            "lineageTag": "d0af9b9d-b0d0-50b4-bbed-8ee6e98943ac"
          },
          {
            "name": "GGR",
            "expression": "[Turnover] - [Payouts]",
            "formatString": "#,0.00",
            "lineageTag": "95b2e69b-b310-55af-855e-9e9beac47552"
          },
          {
            "name": "Bonus Cost (realised)",
            "expression": "CALCULATE ( SUM ( fact_bet[stake_bonus_amount] ), fact_bet[status] = \"lost\" )",
            "formatString": "#,0.00",
            "lineageTag": "c74bec67-550f-59e6-aace-7aa755da2066"
          },
          {
            "name": "NGR",
            "expression": "[GGR] - [Bonus Cost (realised)]",
            "formatString": "#,0.00",
            "lineageTag": "258b88d1-e9d4-542e-a332-4849bf24144b"
          }
        ]
      },

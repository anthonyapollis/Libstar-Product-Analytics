        "measures": [
          {
            "name": "Campaign Bonus Cost",
            "expression": "CALCULATE ( SUM ( fact_bonus_transaction[granted_amount] ), fact_bonus_transaction[status] IN { \"completed\", \"expired\", \"forfeited\" } )",
            "formatString": "#,0.00",
            "lineageTag": "f738b857-d652-5a51-ab83-56063b1fae53"
          },
          {
            "name": "Campaign Bonus Cost % of NGR",
            "expression": "DIVIDE ( [Campaign Bonus Cost], CALCULATE ( [NGR], REMOVEFILTERS ( dim_campaign ) ) )",
            "formatString": "0.00%",
            "lineageTag": "0ce7423e-d973-5a15-a326-74b1b0940c38"
          },
          {
            "name": "Bonus Liability Outstanding",
            "expression": "CALCULATE ( SUM ( fact_bonus_transaction[granted_amount] ), fact_bonus_transaction[status] = \"active\" )",
            "formatString": "#,0.00",
            "lineageTag": "ecf451af-1332-5fd3-a289-f9010ea58217"
          }
        ]

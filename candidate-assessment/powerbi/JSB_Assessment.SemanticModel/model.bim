            "name": "financial_impact",
            "dataType": "decimal",
            "sourceColumn": "financial_impact",
            "lineageTag": "cf64ecaf-1905-50b6-b043-17f59f7c98c0",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "category_type",
            "dataType": "string",
            "sourceColumn": "category_type",
            "lineageTag": "7bd3f8a0-fb7a-54b4-b598-2f89311ec5cd",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "category_label",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH ( fct_recon_exceptions[category],",
              "    \"OK: matched, amount and fee correct\", \"Matched\",",
              "    \"BREAK: duplicate internal SUCCESS deposit for one settlement (double-credit risk)\", \"Duplicate internal deposit\",",
              "    \"BREAK: deposit SUCCESS, no gateway settlement found\", \"No settlement found\",",
              "    \"BREAK: settled fee differs from contracted fee\", \"Fee above contract\",",
              "    \"BREAK: settled gross amount differs from internal amount\", \"Gross amount differs\",",
              "    \"BREAK: duplicate gateway settlement for one reference (double-credit risk)\", \"Duplicate gateway row\",",
              "    \"BREAK: unrecognised settlement (no internal record)\", \"Unrecognised settlement\",",
              "    \"BREAK: net amount is not gross minus fee\", \"Net not gross minus fee\",",
              "    \"BREAK: payment confirmed, wallet not credited\", \"Settled, marked FAILED\",",
              "    \"NOT A PROBLEM: rounding difference <= 1 cent\", \"Rounding (1 cent or less)\",",
              "    \"REVERSAL: gateway reversed/charged back after settlement\", \"Reversal / chargeback\",",
              "    \"TIMING: settlement expected in next period (created near cut-off)\", \"Settles next period\",",
              "    \"TIMING: prior-period deposit settled at start of period\", \"Prior-period deposit\",",
              "    fct_recon_exceptions[category] )"
            ],
            "lineageTag": "c6379f43-df54-5329-84ab-b1222cf5e474",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fct_recon_exceptions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, (v) => if v = \"\" then null else v})),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"deposit_id\", type text}, {\"player_id\", type text}, {\"created_at\", type datetime}, {\"dep_amount\", Currency.Type}, {\"gateway_ref\", type text}, {\"settlement_row_id\", Int64.Type}, {\"gateway_txn_id\", type text}, {\"merchant_ref\", type text}, {\"settled_at\", type datetime}, {\"gross_amount\", Currency.Type}, {\"fee\", Currency.Type}, {\"net_amount\", Currency.Type}, {\"gw_status\", type text}, {\"expected_fee\", Currency.Type}, {\"category\", type text}, {\"financial_impact\", Currency.Type}, {\"category_type\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Exceptions Tile Colour",
            "expression": "IF ( [Exceptions] > 0, \"#D9901A\", \"#1E8C5A\" )",
            "lineageTag": "38029c89-1f8a-50f0-9055-9911a17b186a"
          },
          {
            "name": "Act Now Tile Colour",
            "expression": "IF ( [Act Now Value] > 0, \"#C8413A\", \"#1E8C5A\" )",
            "lineageTag": "dc1c5669-1319-54df-be72-83f997783b0a"
          },
          {
            "name": "Settlements Matched Exactly",
            "expression": "CALCULATE ( COUNTROWS ( fct_recon_exceptions ), fct_recon_exceptions[category_type] = \"OK\" )",
            "formatString": "#,0",
            "lineageTag": "4636cbab-71ce-5ce2-ad46-9fe069a9ad18"
          },
          {
            "name": "Exceptions",
            "expression": "CALCULATE ( COUNTROWS ( fct_recon_exceptions ), fct_recon_exceptions[category_type] <> \"OK\" )",
            "formatString": "#,0",
            "lineageTag": "1d0ed51d-1aac-5c4d-9ba5-b60ef9cd1072"
          },
          {
            "name": "Exception Impact",
            "expression": "CALCULATE ( SUM ( fct_recon_exceptions[financial_impact] ), fct_recon_exceptions[category_type] <> \"OK\" )",
            "formatString": "#,0.00",
            "lineageTag": "fdb7e732-0f2e-51b6-9324-9ec21d61ea8b"
          },
          {
            "name": "Act Now Value",
            "expression": "CALCULATE ( SUM ( fct_recon_exceptions[financial_impact] ), fct_recon_exceptions[category] IN { \"BREAK: payment confirmed, wallet not credited\", \"BREAK: unrecognised settlement (no internal record)\" } )",
            "formatString": "#,0.00",
            "lineageTag": "fc505c4f-01ce-5a64-adf3-7a0364e82eaf"
          }
        ]
      },

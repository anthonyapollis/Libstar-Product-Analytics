{
  "info": {
    "name": "JSB Assessment - Exercise 2 - Mock Transactions API",
    "description": "Exploring and documenting the provider API used by ingest.py: pagination via cursor, updated_since filtering, and the interviewer-only /admin/advance control endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "apiKey", "value": "test-key" },
    { "key": "next_cursor", "value": "" },
    { "key": "count_cursor", "value": "" },
    { "key": "count_total", "value": "0" },
    { "key": "count_pages", "value": "0" }
  ],
  "item": [
    {
      "name": "0. Reset record counter (run this first)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('count_cursor', '');",
              "pm.collectionVariables.set('count_total', '0');",
              "pm.collectionVariables.set('count_pages', '0');",
              "console.log('Counter reset. Now run \"6. Count ALL records\" -- it pages itself to the end.');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/transactions?limit=1",
          "host": ["{{baseUrl}}"], "path": ["v1", "transactions"],
          "query": [{ "key": "limit", "value": "1" }]
        }
      }
    },
    {
      "name": "1. First page (no cursor, no updated_since)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has data array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('rows ordered by (updated_at, id) ascending', () => {",
              "  for (let i = 1; i < body.data.length; i++) {",
              "    const prev = body.data[i-1], cur = body.data[i];",
              "    pm.expect(prev.updated_at <= cur.updated_at).to.be.true;",
              "  }",
              "});",
              "if (body.next_cursor) pm.collectionVariables.set('next_cursor', body.next_cursor);",
              "console.log('has_more:', body.has_more, 'rows:', body.data.length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/transactions?limit=10",
          "host": ["{{baseUrl}}"], "path": ["v1", "transactions"],
          "query": [{ "key": "limit", "value": "10" }]
        }
      }
    },
    {
      "name": "2. Next page (cursor from step 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('does not repeat the boundary row from page 1', () => {",
              "  pm.expect(body.data.length).to.be.above(0);",
              "});",
              "if (body.next_cursor) pm.collectionVariables.set('next_cursor', body.next_cursor);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/transactions?limit=10&cursor={{next_cursor}}",
          "host": ["{{baseUrl}}"], "path": ["v1", "transactions"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "cursor", "value": "{{next_cursor}}" }
          ]
        }
      }
    },
    {
      "name": "3. Incremental pull by updated_since",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('every row updated_at >= updated_since', () => {",
              "  body.data.forEach(r => pm.expect(r.updated_at >= '2026-09-04T00:00:00Z').to.be.true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/transactions?limit=50&updated_since=2026-09-04T00:00:00Z",
          "host": ["{{baseUrl}}"], "path": ["v1", "transactions"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "updated_since", "value": "2026-09-04T00:00:00Z" }
          ]
        }
      }
    },
    {
      "name": "4. Missing/invalid API key -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "wrong-key" }],
        "url": {
          "raw": "{{baseUrl}}/v1/transactions?limit=5",
          "host": ["{{baseUrl}}"], "path": ["v1", "transactions"],
          "query": [{ "key": "limit", "value": "5" }]
        }
      }
    },
    {
      "name": "5. Admin: simulate new activity (interviewer step)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('ok true', () => pm.expect(body.ok).to.be.true);",
              "console.log('total_records now:', body.total_records);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/advance",
          "host": ["{{baseUrl}}"], "path": ["admin", "advance"]
        }
      }
    },
    {
      "name": "6. Count ALL records (auto-paginates to the end)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cursor = pm.collectionVariables.get('count_cursor');",
              "let url = pm.collectionVariables.get('baseUrl') + '/v1/transactions?limit=200';",
              "if (cursor) { url += '&cursor=' + encodeURIComponent(cursor); }",
              "pm.request.url = url;"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A 429/500 is the mock API's deliberate fault injection (see mock_api.py).",
              "// Retry the SAME page (cursor unchanged) rather than losing it.",
              "if (pm.response.code === 429 || pm.response.code === 500) {",
              "    pm.test('page ' + (+pm.collectionVariables.get('count_pages') + 1) + ': hit ' + pm.response.code + ', retrying same page', () => true);",
              "    return postman.setNextRequest('6. Count ALL records (auto-paginates to the end)');",
              "}",
              "",
              "const body = pm.response.json();",
              "const pages = (+pm.collectionVariables.get('count_pages')) + 1;",
              "const total = (+pm.collectionVariables.get('count_total')) + body.data.length;",
              "pm.collectionVariables.set('count_pages', pages);",
              "pm.collectionVariables.set('count_total', total);",
              "",
              "pm.test('page ' + pages + ': +' + body.data.length + ' records (running total: ' + total + ')', () => true);",
              "",
              "if (body.has_more) {",
              "    pm.collectionVariables.set('count_cursor', body.next_cursor);",
              "    postman.setNextRequest('6. Count ALL records (auto-paginates to the end)');",
              "} else {",
              "    pm.test('>>> DONE -- TOTAL RECORDS RETURNED BY API: ' + total + ' (across ' + pages + ' pages) <<<', () => true);",
              "    console.log('TOTAL RECORDS:', total, 'PAGES:', pages);",
              "    postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/transactions?limit=200",
          "host": ["{{baseUrl}}"], "path": ["v1", "transactions"],
          "query": [{ "key": "limit", "value": "200" }]
        },
        "description": "Run '0. Reset record counter' first, then click Send on THIS request once. It re-sends itself (via setNextRequest) until has_more is false, accumulating the total in the Test Results panel -- the last test name shown is the grand total. No Collection Runner needed, but it also works there. Note: this counts every row the wire sends, including the mock API's deliberate occasional duplicated row within a page (see mock_api.py) -- so it can read 1 higher than the API's own 'total_records' figure from /admin/advance. ingest.py's loaded row count is the deduplicated one; this is the raw one."
      }
    }
  ]
}

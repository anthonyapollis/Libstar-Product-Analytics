{
  "datasets": [
    {
      "name": "gate_kpis",
      "displayName": "Release gate KPIs (run 1, supplied data)",
      "queryLines": [
        "SELECT CASE WHEN count_if(m.blocks_release) > 0 THEN 'BLOCK' ELSE 'RELEASE' END AS release_decision,\n",
        "       concat(count_if(m.status = 'FAIL'), ' of ', count(*))                      AS rules_failing,\n",
        "       count_if(m.blocks_release)                                                 AS blocking_rules,\n",
        "       (SELECT count(DISTINCT employee_id) FROM workspace.employee360_medallion.dq_failure_detail\n",
        "         WHERE run_ts = (SELECT min(run_ts) FROM workspace.employee360_medallion.dq_failure_detail))                                                AS employees_failing,\n",
        "       (SELECT concat(count_if(is_trusted), ' of ', count(*))\n",
        "          FROM workspace.employee360_medallion.gold_employee_360_supplied)                                    AS gold_trusted\n",
        "FROM workspace.employee360_medallion.gold_dq_monitoring m\n",
        "WHERE m.run_id = 1\n"
      ]
    },
    {
      "name": "rules",
      "displayName": "Monitoring by rule (run 1, supplied data)",
      "queryLines": [
        "SELECT rule_id, rule, dimension, status, affected_count, severity, action,\n",
        "       alert_when_affected AS alert_threshold, alert_fired, blocks_release, owner, affected_ids,\n",
        "       concat(rule_id, ' (', severity, ')') AS rule_label\n",
        "FROM workspace.employee360_medallion.gold_dq_monitoring\n",
        "WHERE run_id = 1\n",
        "ORDER BY CASE severity WHEN 'Critical' THEN 1 WHEN 'High' THEN 2 ELSE 3 END, rule_id\n"
      ]
    },
    {
      "name": "gold_vs_delivered",
      "displayName": "Gold vs delivered Employee 360 (supplied data)",
      "queryLines": [
        "SELECT 1 AS sort, 'Employees' AS measure,\n",
        "       (SELECT count(*) FROM workspace.employee360_medallion.gold_employee_360_supplied) AS gold,\n",
        "       (SELECT count(*) FROM workspace.employee360_medallion.silver_e360_delivered_supplied) AS delivered_e360\n",
        "UNION ALL\n",
        "SELECT 2, 'Active employees',\n",
        "       (SELECT count_if(employment_status = 'Active') FROM workspace.employee360_medallion.gold_employee_360_supplied),\n",
        "       (SELECT count_if(employment_status = 'Active') FROM workspace.employee360_medallion.silver_e360_delivered_supplied)\n",
        "UNION ALL\n",
        "SELECT 3, 'Employees with a verified ZAR salary',\n",
        "       (SELECT count(monthly_salary_zar) FROM workspace.employee360_medallion.gold_employee_360_supplied),\n",
        "       (SELECT count(monthly_salary) FROM workspace.employee360_medallion.silver_e360_delivered_supplied)\n",
        "UNION ALL\n",
        "SELECT 4, 'Trusted records (no open source-quality rule, salary verified)',\n",
        "       (SELECT count_if(is_trusted) FROM workspace.employee360_medallion.gold_employee_360_supplied), NULL\n",
        "ORDER BY sort\n"
      ]
    },
    {
      "name": "gold_untrusted",
      "displayName": "Untrusted Gold employees (supplied data)",
      "queryLines": [
        "SELECT employee_id, full_name, employment_status, payroll_status, monthly_salary_zar,\n",
        "       array_join(dq_rules_failed, ', ') AS dq_rules_failed\n",
        "FROM workspace.employee360_medallion.gold_employee_360_supplied\n",
        "WHERE NOT is_trusted\n",
        "ORDER BY employee_id\n"
      ]
    },
    {
      "name": "failure_detail",
      "displayName": "Failure detail (run 1, supplied data)",
      "queryLines": [
        "SELECT rule_id, employee_id, source, detail\n",
        "FROM workspace.employee360_medallion.dq_failure_detail\n",
        "WHERE run_ts = (SELECT min(run_ts) FROM workspace.employee360_medallion.dq_failure_detail)\n",
        "ORDER BY rule_id, employee_id, source\n"
      ]
    },
    {
      "name": "runs",
      "displayName": "Issues per pipeline run",
      "queryLines": [
        "SELECT run_id, CASE run_id WHEN 1 THEN 'Run 1 (supplied data)' WHEN 2 THEN 'Run 2 (same files, skipped)'\n",
        "       WHEN 3 THEN 'Run 3 (simulated delivery)' ELSE concat('Run ', run_id) END AS run_label, measure, issues\n",
        "FROM workspace.employee360_medallion.dq_runs\n",
        "LATERAL VIEW stack(3, 'New', new_issues, 'Resolved', resolved_issues, 'Open', open_issues) s AS measure, issues\n",
        "ORDER BY run_id, measure\n"
      ]
    },
    {
      "name": "issues",
      "displayName": "Issue lifecycle (state after Run 3 (simulated delivery))",
      "queryLines": [
        "SELECT rule_id, employee_id, status, first_seen_run, last_seen_run, resolved_run, detail\n",
        "FROM workspace.employee360_medallion.dq_issues\n",
        "ORDER BY rule_id, employee_id\n"
      ]
    },
    {
      "name": "batches",
      "displayName": "Ingest batches",
      "queryLines": [
        "SELECT b.source, b.batch_id,\n",
        "       (SELECT CASE run_id WHEN 1 THEN 'Run 1 (supplied data)' WHEN 2 THEN 'Run 2 (same files, skipped)'\n",
        "       WHEN 3 THEN 'Run 3 (simulated delivery)' ELSE concat('Run ', run_id) END FROM workspace.employee360_medallion.dq_runs r WHERE r.run_at >= b.loaded_at ORDER BY r.run_at LIMIT 1) AS loaded_by_run,\n",
        "       b.rows_in_file, b.rows_inserted, b.rows_in_file - b.rows_inserted AS rows_unchanged,\n",
        "       b.rows_dropped, b.skipped AS file_skipped, b.loaded_at\n",
        "FROM workspace.employee360_medallion.ingest_batches b\n",
        "ORDER BY b.batch_id, b.source\n"
      ]
    },
    {
      "name": "reconciliation_categories",
      "displayName": "Reconciliation categories (latest run, supplied data)",
      "queryLines": [
        "WITH k AS (\n",
        "  SELECT employee_id, key_status AS category FROM workspace.employee360_medallion.dq_recon_keys\n",
        "  WHERE run_ts = (SELECT max(run_ts) FROM workspace.employee360_medallion.dq_recon_keys)\n",
        "    AND key_status IN ('Missing downstream', 'Unexpected downstream')),\n",
        "f AS (\n",
        "  SELECT employee_id, CASE classification WHEN 'Error' THEN 'Field error' ELSE classification END AS category\n",
        "  FROM workspace.employee360_medallion.dq_recon_fields\n",
        "  WHERE run_ts = (SELECT max(run_ts) FROM workspace.employee360_medallion.dq_recon_fields)),\n",
        "cat AS (\n",
        "  SELECT * FROM VALUES\n",
        "    (1, 'Missing downstream', true, 'Critical', 'In HR and payroll but missing from Employee 360 (RC01)'),\n",
        "    (2, 'Unexpected downstream', true, 'Critical', 'In Employee 360 with no HR or payroll record (RC02)'),\n",
        "    (3, 'Field error', true, 'Critical / High', 'Employee 360 differs from, or cannot be traced to, the system of record (RC03, RC04)'),\n",
        "    (4, 'Cannot verify', true, 'Critical', 'The system of record is ambiguous, so the Employee 360 value cannot be verified (RC03)'),\n",
        "    (5, 'Legitimate exception', false, 'Not a failure', 'A difference that is correct (e.g. a future-dated HR change); shown for transparency, does not count as a failure or block release')\n",
        "    AS t(sort_order, category, counts_as_failure, severity, meaning))\n",
        "SELECT c.sort_order, c.category,\n",
        "       count(DISTINCT e.employee_id) AS employees,\n",
        "       array_join(array_sort(collect_set(e.employee_id)), ', ') AS employee_ids,\n",
        "       c.counts_as_failure,\n",
        "       CASE WHEN c.counts_as_failure THEN 'Counts as failure' ELSE 'Not a failure' END AS failure_label,\n",
        "       c.severity, c.meaning\n",
        "FROM cat c LEFT JOIN (SELECT * FROM k UNION ALL SELECT * FROM f) e ON e.category = c.category\n",
        "GROUP BY c.sort_order, c.category, c.counts_as_failure, c.severity, c.meaning\n",
        "ORDER BY c.sort_order"
      ]
    }
  ],

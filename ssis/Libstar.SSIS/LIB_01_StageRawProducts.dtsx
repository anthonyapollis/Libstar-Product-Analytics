    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{436E4983-9D5D-4D68-BA64-069AE49F28F6}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Check free disk space" DTS:refId="Package\SQL Check free disk space" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Libstar_SSIS" SQLTask:SqlStatementSource="&#xA;/* Fail in seconds, not 25 minutes in: a full reload filled this disk twice during development.&#xA;   Threshold from etl.Config MinFreeDiskMB (default 1500). */&#xA;DECLARE @freeMB bigint = (SELECT MIN(vs.available_bytes) / 1048576&#xA;                          FROM sys.database_files f&#xA;                          CROSS APPLY sys.dm_os_volume_stats(DB_ID(), f.file_id) vs);&#xA;DECLARE @needMB bigint = COALESCE(TRY_CONVERT(bigint, (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'MinFreeDiskMB')), 1500);&#xA;IF @freeMB &lt; @needMB&#xA;BEGIN&#xA;    DECLARE @msg nvarchar(400) = CONCAT('Free disk space check: ', @freeMB, ' MB free on the database volume, ', @needMB,&#xA;                                        ' MB required. Free space or lower etl.Config MinFreeDiskMB.');&#xA;    THROW 50020, @msg, 1;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{391A2B2E-FFE1-4B96-8C52-DE0DE61D3828}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Truncate stg products_raw" DTS:refId="Package\SQL Truncate stg products_raw" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>

    <DTS:Executable DTS:CreationName="STOCK:FOREACHLOOP" DTS:DelayValidation="True" DTS:DTSID="{90804A9A-FD24-49A1-8FA7-AA88C7A915E1}" DTS:ExecutableType="STOCK:FOREACHLOOP" DTS:LocaleID="-1" DTS:ObjectName="FELC Each raw products archive" DTS:refId="Package\FELC Each raw products archive">
      <DTS:Executables>
        <DTS:Executable DTS:CreationName="Microsoft.ScriptTask" DTS:DTSID="{D61AEB3A-9280-44C3-BDE1-6DCD67FAEE0A}" DTS:ExecutableType="Microsoft.ScriptTask" DTS:LocaleID="-1" DTS:ObjectName="SCR Expand archive to work folder" DTS:refId="Package\FELC Each raw products archive\SCR Expand archive to work folder">
          <DTS:ObjectData>
            <ScriptProject Language="CSharp" Name="ST_DecompressRawProducts" ReadOnlyVariables="User::CurrentArchive,User::WorkFolderPath" ReadWriteVariables="User::CurrentFile" VSTAMajorVersion="15" VSTAMinorVersion="0">
              <BinaryItem Name="\bin\release\ST_DecompressRawProducts.csproj.dll"></BinaryItem>
              <ProjectItem Encoding="UTF8" Name="Properties\AssemblyInfo.cs"><![CDATA[
using System.Reflection;
[assembly: AssemblyTitle("ST_DecompressRawProducts")]
[assembly: AssemblyVersion("1.0.*")]
        ]]></ProjectItem>
              <ProjectItem Encoding="UTF8" Name="ScriptMain.cs"><![CDATA[
using System;
using System.IO;
using System.IO.Compression;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_DecompressRawProducts
{
    /// <summary>
    /// SSIS cannot read gzip natively. Expands the archive in User::CurrentArchive into the work
    /// folder and returns the CSV path in User::CurrentFile. The loop stages that CSV and deletes it
    /// before expanding the next archive, so only one ~80 MB file is ever on disk (all ten at once
    /// filled a small development disk).
    /// </summary>
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            bool fireAgain = true;
            string archive = (string)Dts.Variables["User::CurrentArchive"].Value;
            string workFolder = (string)Dts.Variables["User::WorkFolderPath"].Value;
            try
            {
                if (!File.Exists(archive))
                    throw new FileNotFoundException("Archive not found: " + archive);
                Directory.CreateDirectory(workFolder);
                string csv = Path.Combine(workFolder, Path.GetFileNameWithoutExtension(archive));
                using (FileStream input = File.OpenRead(archive))
                using (GZipStream unzip = new GZipStream(input, CompressionMode.Decompress))
                using (FileStream output = File.Create(csv))
                {
                    unzip.CopyTo(output, 1 << 20);
                }
                Dts.Variables["User::CurrentFile"].Value = csv;
                Dts.Events.FireInformation(0, "Decompress", "Expanded " + archive + " -> " + csv, "", 0, ref fireAgain);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Decompress", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}
]]></ProjectItem>

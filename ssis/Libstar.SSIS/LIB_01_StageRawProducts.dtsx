    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{DCC7A111-B59A-4507-9CF4-5D2FB15C773D}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Resolve folders from parameters or etl_Config" DTS:refId="Package\SQL Resolve folders from parameters or etl_Config" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Libstar_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;DECLARE @raw nvarchar(400) = COALESCE(NULLIF(?, N''), (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'RawFolder'));&#xA;DECLARE @work nvarchar(400) = COALESCE(NULLIF(?, N''), (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'WorkFolder'));&#xA;DECLARE @ref nvarchar(400) = COALESCE(NULLIF(?, N''), (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'ReferenceFolder'));&#xA;IF @raw IS NULL OR @work IS NULL OR @ref IS NULL&#xA;    THROW 50010, 'Folder locations are not configured. Pass the RawFolder/WorkFolder/ReferenceFolder parameters or run ssis\run_ssis.ps1 -Configure.', 1;&#xA;SELECT @raw AS RawFolderPath, @work AS WorkFolderPath, @ref AS ReferenceFolderPath;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="User::RawFolderParam" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="400" />
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="User::WorkFolderParam" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="1" SQLTask:ParameterSize="400" />
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="User::ReferenceFolderParam" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="2" SQLTask:ParameterSize="400" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::RawFolderPath" SQLTask:ResultName="0" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::WorkFolderPath" SQLTask:ResultName="1" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::ReferenceFolderPath" SQLTask:ResultName="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>

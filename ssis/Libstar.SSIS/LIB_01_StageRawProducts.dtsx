using System.Reflection;
[assembly: AssemblyTitle("ST_DecompressRawProducts")]
[assembly: AssemblyVersion("1.0.*")]
        ]]></ProjectItem>
          <ProjectItem Encoding="UTF8" Name="ScriptMain.cs"><![CDATA[
using System;
using System.IO;
using System.IO.Compression;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_DecompressRawProducts
{
    /// <summary>
    /// SSIS cannot read gzip natively. Expands every products_part_*.csv.gz in the raw
    /// folder into the work folder. Skips a file whose expanded copy is already newer
    /// than the archive, so a re-run after a downstream failure does not redo the work.
    /// </summary>
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            bool fireAgain = true;
            string rawFolder = (string)Dts.Variables["User::RawFolderPath"].Value;
            string workFolder = (string)Dts.Variables["User::WorkFolderPath"].Value;
            try
            {
                Dts.Events.FireInformation(0, "Decompress", "Working directory: " + Environment.CurrentDirectory + "; raw folder resolves to " + Path.GetFullPath(rawFolder), "", 0, ref fireAgain);
                if (!Directory.Exists(rawFolder))
                    throw new DirectoryNotFoundException("Raw folder not found: " + Path.GetFullPath(rawFolder) + " (parameter RawFolder = '" + rawFolder + "', working directory = " + Environment.CurrentDirectory + ")");
                Directory.CreateDirectory(workFolder);

                string[] archives = Directory.GetFiles(rawFolder, "products_part_*.csv.gz");
                if (archives.Length == 0)
                    throw new FileNotFoundException("No products_part_*.csv.gz files in " + rawFolder);

                foreach (string gz in archives)
                {
                    string csv = Path.Combine(workFolder, Path.GetFileNameWithoutExtension(gz));
                    if (File.Exists(csv) && File.GetLastWriteTimeUtc(csv) >= File.GetLastWriteTimeUtc(gz) && new FileInfo(csv).Length > 0)
                    {
                        Dts.Events.FireInformation(0, "Decompress", "Up to date, skipped: " + csv, "", 0, ref fireAgain);
                        continue;
                    }
                    using (FileStream input = File.OpenRead(gz))
                    using (GZipStream unzip = new GZipStream(input, CompressionMode.Decompress))
                    using (FileStream output = File.Create(csv))
                    {
                        unzip.CopyTo(output, 1 << 20);
                    }
                    Dts.Events.FireInformation(0, "Decompress", "Expanded " + gz + " -> " + csv, "", 0, ref fireAgain);
                }
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Decompress", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}
]]></ProjectItem>

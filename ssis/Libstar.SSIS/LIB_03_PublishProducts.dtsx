    <DTS:PrecedenceConstraint DTS:CreationName="" DTS:DTSID="{36F7353E-4A1A-4D39-891E-175D8E4AE800}" DTS:From="Package\SQL Reconciliation gate" DTS:LogicalAnd="True" DTS:ObjectName="Constraint_SQL Reconciliation gate_To_SQL Publish deduplicated products" DTS:refId="Package.PrecedenceConstraints[Constraint_SQL Reconciliation gate_To_SQL Publish deduplicated products]" DTS:To="Package\SQL Publish deduplicated products" />
    <DTS:PrecedenceConstraint DTS:CreationName="" DTS:DTSID="{37CDE00C-5E85-4D45-ADA6-1EE1EE35BE85}" DTS:From="Package\SQL Publish deduplicated products" DTS:LogicalAnd="True" DTS:ObjectName="Constraint_SQL Publish deduplicated products_To_SQL Log run success" DTS:refId="Package.PrecedenceConstraints[Constraint_SQL Publish deduplicated products_To_SQL Log run success]" DTS:To="Package\SQL Log run success" />

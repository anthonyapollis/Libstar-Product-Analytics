    <DTS:Variable DTS:CreationName="" DTS:DTSID="{CD2199B3-682A-48B1-8CEC-0C39B9D1ED12}" DTS:IncludeInDebugDump="6789" DTS:Namespace="User" DTS:ObjectName="RowsRejected">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>

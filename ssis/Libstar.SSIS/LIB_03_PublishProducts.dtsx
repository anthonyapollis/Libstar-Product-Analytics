  <DTS:EventHandlers>
    <DTS:EventHandler DTS:CreationName="OnError" DTS:DTSID="{EC2FA1F1-690E-4F05-9D3A-2A84729687E1}" DTS:EventID="0" DTS:EventName="OnError" DTS:LocaleID="-1" DTS:refId="Package.EventHandlers[OnError]">

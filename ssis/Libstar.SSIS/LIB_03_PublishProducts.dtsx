    <DTS:PrecedenceConstraint DTS:CreationName="" DTS:DTSID="{3434BA77-DEDC-474D-8114-562A5AA5274B}" DTS:From="Package\SQL Reconciliation gate" DTS:LogicalAnd="True" DTS:ObjectName="Constraint_SQL Reconciliation gate_To_SQL Publish deduplicated products" DTS:refId="Package.PrecedenceConstraints[Constraint_SQL Reconciliation gate_To_SQL Publish deduplicated products]" DTS:To="Package\SQL Publish deduplicated products" />
    <DTS:PrecedenceConstraint DTS:CreationName="" DTS:DTSID="{F5BE0D96-F916-419A-AE1E-667FBD08AFF1}" DTS:From="Package\SQL Publish deduplicated products" DTS:LogicalAnd="True" DTS:ObjectName="Constraint_SQL Publish deduplicated products_To_SQL Log run success" DTS:refId="Package.PrecedenceConstraints[Constraint_SQL Publish deduplicated products_To_SQL Log run success]" DTS:To="Package\SQL Log run success" />

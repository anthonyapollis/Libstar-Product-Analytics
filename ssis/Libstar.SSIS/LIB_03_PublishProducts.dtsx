  <DTS:Executables>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{7D88BF8E-DD36-4601-AA30-A05BFA93A48F}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Log run start" DTS:refId="Package\SQL Log run start" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Libstar_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="SET NOCOUNT ON; INSERT INTO etl.PackageRun (PackageName, ExecutionGuid) OUTPUT inserted.RunId VALUES (?, ?);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="200" />
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="System::ExecutionInstanceGUID" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="1" SQLTask:ParameterSize="50" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::RunId" SQLTask:ResultName="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{078B729B-0C40-4B56-B1CD-B0FD76652788}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Reconciliation gate" DTS:refId="Package\SQL Reconciliation gate" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Libstar_SSIS" SQLTask:SqlStatementSource="&#xA;/* Nothing is published unless every staged row is accounted for. */&#xA;DECLARE @raw bigint = (SELECT COUNT_BIG(*) FROM stg.products_raw),&#xA;        @valid bigint = (SELECT COUNT_BIG(*) FROM stg.products_valid),&#xA;        @quarantine bigint = (SELECT COUNT_BIG(*) FROM dq.products_quarantine);&#xA;IF @raw = 0&#xA;    THROW 50001, 'Reconciliation gate: stg.products_raw is empty.', 1;&#xA;IF @raw &lt;&gt; @valid + @quarantine&#xA;BEGIN&#xA;    DECLARE @msg nvarchar(400) = CONCAT('Reconciliation gate: raw ', @raw, ' &lt;&gt; valid ', @valid, ' + quarantine ', @quarantine);&#xA;    THROW 50002, @msg, 1;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{9D65EDC0-DB84-43F2-BFF8-ED2FA9C228DB}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Publish deduplicated products" DTS:refId="Package\SQL Publish deduplicated products" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Libstar_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="&#xA;/* Latest date_added wins per product_id, as in ADF. Deduplicating 4M+ rows in one statement sorts the&#xA;   whole set in tempdb, which filled a small server's disk; hash buckets keep each sort to 1/8 of the rows.&#xA;   Each bucket commits on its own and the step truncates first, so a rerun after a failure starts clean. */&#xA;SET NOCOUNT ON;&#xA;DECLARE @buckets int = 8, @b int = 0, @published int = 0;&#xA;TRUNCATE TABLE dw.products_clean;&#xA;WHILE @b &lt; @buckets&#xA;BEGIN&#xA;    INSERT INTO dw.products_clean WITH (TABLOCK)&#xA;        (product_id, sku, product_name, product_group, category, brand, brand_solution, sales_channel, province,&#xA;         price_zar, cost_zar, margin_pct, weight_kg, stock_qty, units_sold_12m, revenue_12m_zar, date_added, is_active, rating, load_run_id)&#xA;    SELECT product_id, sku, product_name, product_group, category, brand, brand_solution, sales_channel, province,&#xA;           price_zar, cost_zar, margin_pct, weight_kg, stock_qty, units_sold_12m, revenue_12m_zar, date_added, is_active, rating, load_run_id&#xA;    FROM (&#xA;        SELECT *, ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY date_added DESC) AS rn&#xA;        FROM stg.products_valid&#xA;        WHERE (CHECKSUM(product_id) &amp; 2147483647) % @buckets = @b&#xA;    ) v&#xA;    WHERE rn = 1;&#xA;    SET @published += @@ROWCOUNT;&#xA;    SET @b += 1;&#xA;    CHECKPOINT;&#xA;END;&#xA;SELECT (SELECT CAST(COUNT_BIG(*) AS int) FROM stg.products_valid) AS RowsRead,&#xA;       @published AS RowsWritten,&#xA;       (SELECT CAST(COUNT_BIG(*) AS int) FROM stg.products_valid) - @published AS RowsRejected;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::RowsRead" SQLTask:ResultName="0" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::RowsWritten" SQLTask:ResultName="1" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::RowsRejected" SQLTask:ResultName="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{97A786BF-5FFD-4542-A3CE-9AD6FC4D9E9E}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Log run success" DTS:refId="Package\SQL Log run success" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Libstar_SSIS" SQLTask:SqlStatementSource="UPDATE etl.PackageRun SET EndTime = SYSDATETIME(), Status = 'Succeeded', RowsRead = ?, RowsWritten = ?, RowsRejected = ? WHERE RunId = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsRead" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsWritten" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="1" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsRejected" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="2" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RunId" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="3" SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>

  <DTS:EventHandlers>
    <DTS:EventHandler DTS:CreationName="OnError" DTS:DTSID="{997C5175-16D1-4802-95C8-233E5EE53E89}" DTS:EventID="0" DTS:EventName="OnError" DTS:LocaleID="-1" DTS:refId="Package.EventHandlers[OnError]">
      <DTS:Variables>
